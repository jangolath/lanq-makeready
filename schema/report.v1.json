{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lanq-makeready/v1",
  "title": "lanq-makeready report v1",
  "type": "object",
  "required": ["schema", "tool", "generatedAt", "host", "verdicts", "checks", "capabilities", "suggestedMachine"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lanq-makeready/v1" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "const": "lanq-makeready" }, "version": { "type": "string" } }
    },
    "generatedAt": { "type": "string", "format": "date-time", "description": "UTC, ISO 8601" },
    "host": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "hostname": { "type": "string", "description": "<redacted> with --redact" },
        "user": { "type": "string", "description": "<redacted> with --redact" },
        "os": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "verdicts": {
      "type": "object",
      "required": ["worker_git", "worker_archive", "dotnet10", "docker", "overnight"],
      "additionalProperties": false,
      "properties": {
        "worker_git": { "$ref": "#/$defs/status" },
        "worker_archive": { "$ref": "#/$defs/status" },
        "dotnet10": { "$ref": "#/$defs/status" },
        "docker": { "$ref": "#/$defs/status" },
        "overnight": { "$ref": "#/$defs/status" }
      }
    },
    "summary": {
      "type": "object",
      "description": "Optional (0.2.0+). The one-line verdict and the numbered next steps (every WARN/FAIL check, blockers first).",
      "required": ["verdict", "text", "blockers", "warnings", "nextSteps"],
      "properties": {
        "verdict": { "enum": ["READY", "READY_WITH_WARNINGS", "NOT_READY"] },
        "text": { "type": "string", "description": "READY, READY WITH WARNINGS (n) or NOT READY (n blockers)" },
        "blockers": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "nextSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "id", "title", "status", "blocker", "detail", "action", "adminToFix"],
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "id": { "type": "string" },
              "title": { "type": "string" },
              "status": { "enum": ["WARN", "FAIL"] },
              "blocker": { "type": "boolean" },
              "detail": { "type": "string" },
              "action": { "type": "string", "description": "Printed command or GUI path; the tool never runs it." },
              "adminToFix": { "type": "boolean", "description": "Acting on the action needs admin/root." }
            }
          }
        }
      }
    },
    "suitedFor": {
      "type": "object",
      "description": "Optional (0.2.0+). Job sizing hint: light (under 6 GB), medium (6-16 GB), heavy (16 GB+ and 4+ logical CPUs).",
      "required": ["tier", "containers", "text"],
      "properties": {
        "tier": { "enum": ["light", "medium", "heavy"] },
        "containers": { "type": "boolean", "description": "A local Docker engine answers." },
        "text": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "detail", "advice", "needsAdmin"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "$ref": "#/$defs/status" },
          "detail": { "type": "string" },
          "advice": { "type": "string", "description": "Printed advice only; the tool never runs it." },
          "needsAdmin": { "type": "boolean" }
        }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "description": "Detected AND working; OS tag omitted." },
    "suggestedMachine": {
      "type": "object",
      "required": ["name", "os", "ssh", "work_root", "capabilities", "max_jobs", "transfer"],
      "properties": {
        "name": { "type": "string" },
        "os": { "enum": ["windows", "linux", "macos-unsupported"] },
        "ssh": { "type": "string", "description": "Placeholder; the user must confirm." },
        "work_root": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "max_jobs": { "type": "integer", "minimum": 1, "description": "From RAM (under 6 GB 1, 8 GB 2, 16 GB 3-4, 32 GB+ 6-8), capped by logical CPUs." },
        "min_free_mem_gb": { "type": "number", "minimum": 0, "description": "Optional (0.2.0+): 1.5 under 6 GB, else 2." },
        "path_prepend": { "type": "array", "items": { "type": "string" }, "description": "Optional (0.3.0+), only when the newest .NET SDK is in a folder that is not the dotnet on PATH: that folder, forward slashes (LanQueue 0.8+ key)." },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Optional (0.3.0+), with path_prepend: DOTNET_ROOT set to the same folder." },
        "transfer": { "enum": ["git", "archive", "none"] },
        "allowed_hours": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "wake": {
          "type": "object",
          "description": "Optional (0.2.0+), only when the wol check is OK. mac is <mac> under --redact.",
          "required": ["mac"],
          "properties": { "mac": { "type": "string" } }
        }
      }
    }
  },
  "$defs": { "status": { "enum": ["OK", "WARN", "FAIL", "SKIP"] } }
}
